https://leetcode.com/problems/richest-customer-wealth/


class Solution {
    public int maximumWealth(int[][] accounts) {
     int sum = 0;
        for(int i =0;i<accounts.length;i++){
            int a = 0;
            for(int j = 0;j<accounts[i].length;j++){
                a+=accounts[i][j];
            }
             sum = Math.max(sum,a);
        }
        return sum;   
    }
}