https://leetcode.com/problems/majority-element/


class Solution {
    public int majorityElement(int[] nums) {
        int c = 0;
        int m = 0;

        for (int i = 0; i < nums.length; i++) {
            int num = nums[i];

            if (c == 0) {
                m = num;
            }

            if (num == m) {
                c++;
            } else {
                c--;
            }
        }

        return m;  
    }
}