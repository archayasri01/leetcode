https://leetcode.com/problems/max-consecutive-ones-iii/


class Solution {
    public int longestOnes(int[] nums, int k) {
        int max=0;
        int i=0;
        int count=0;
        for(int j=0;j<nums.length;j++){
            if(nums[j]==0){
                count++;
            }
        while(count>k){
            if(nums[i]==0){
                count--;
            }
            i++;
        }
        if(count<=k){
            max=Math.max(max,j-i+1);
        }
        }
        return max;
    }
}