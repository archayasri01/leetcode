https://leetcode.com/problems/best-time-to-buy-and-sell-stock/


class Solution {
    public int maxProfit(int[] prices) {
      int m = Integer.MAX_VALUE;
        int n = 0;
        int p = 0;
        for(int i = 0; i < prices.length; i++){
            if(prices[i] < m){
                m = prices[i];
            }
            p = prices[i] - m;
            if(n < p){
                n = p;
            }
        }
        return n;
    }
}